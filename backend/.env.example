# Copy to backend/.env and fill in. Never commit .env.
DATABASE_URL=sqlite:///./vandal.db   # or postgresql+psycopg://... (Supabase session pooler)
ANTHROPIC_API_KEY=
MODEL_AGENT=claude-sonnet-5-5
MODEL_SYNTH=claude-opus-5-5
LLM_TIMEOUT=60                       # seconds per Claude call before falling back
SEARCH_DEPTH=3                       # exhaustive depth 4 is ~75s; see IMPLEMENTATION R4
SEARCH_WORKERS=8
DEMO_PLAYBACK=false
